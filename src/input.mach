# keyboard, mouse, cursor, clipboard, joystick, and gamepad
#
# per-window input state and callbacks, cursor objects, and the
# joystick/gamepad API. key and button constants live in glfw.key,
# glfw.mouse, and glfw.joystick.

use glfw.c;
use glfw.window.Window;
use std.types.bool.bool;
use std.types.string.str;

# input mode ids for get_input_mode/set_input_mode.
pub val CURSOR:               i32 = 0x00033001;
pub val STICKY_KEYS:          i32 = 0x00033002;
pub val STICKY_MOUSE_BUTTONS: i32 = 0x00033003;
pub val LOCK_KEY_MODS:        i32 = 0x00033004;
pub val RAW_MOUSE_MOTION:     i32 = 0x00033005;

# values for the CURSOR input mode.
pub val CURSOR_NORMAL:   i32 = 0x00034001;
pub val CURSOR_HIDDEN:   i32 = 0x00034002;
pub val CURSOR_DISABLED: i32 = 0x00034003;
pub val CURSOR_CAPTURED: i32 = 0x00034004;

# handle to a cursor image
# ---
# handle: opaque GLFWcursor pointer, nil when invalid
pub rec Cursor {
    handle: ptr;
}

# the nil Cursor, for restoring the default cursor
# ---
# ret: a Cursor with a nil handle
pub fun no_cursor() Cursor {
    ret Cursor{ handle: nil };
}

# whether a Cursor holds a live handle
# ---
# cursor: cursor to test
# ret:    true if the handle is non-nil
pub fun cursor_is_valid(cursor: Cursor) bool {
    ret cursor.handle != nil;
}

# key callback (window, key, scancode, action, mods)
pub def KeyFun: fun(ptr, i32, i32, i32, i32);
# text input callback (window, codepoint)
pub def CharFun: fun(ptr, u32);
# text input with modifiers callback (window, codepoint, mods)
pub def CharModsFun: fun(ptr, u32, i32);
# mouse button callback (window, button, action, mods)
pub def MouseButtonFun: fun(ptr, i32, i32, i32);
# cursor position callback (window, xpos, ypos)
pub def CursorPosFun: fun(ptr, f64, f64);
# cursor enter/leave callback (window, entered)
pub def CursorEnterFun: fun(ptr, i32);
# scroll callback (window, xoffset, yoffset)
pub def ScrollFun: fun(ptr, f64, f64);
# path drop callback (window, count, paths)
pub def DropFun: fun(ptr, i32, **u8);
# joystick configuration callback (jid, core.CONNECTED or
# core.DISCONNECTED)
pub def JoystickFun: fun(i32, i32);

# read an input mode of the window
# ---
# window: window to query
# mode:   input mode id
# ret:    current value
pub fun get_input_mode(window: Window, mode: i32) i32 {
    ret c.glfwGetInputMode(window.handle, mode);
}

# set an input mode of the window
# ---
# window: window to change
# mode:   input mode id
# value:  new value
pub fun set_input_mode(window: Window, mode: i32, value: i32) {
    c.glfwSetInputMode(window.handle, mode, value);
}

# whether raw mouse motion is available
# ---
# ret: true if the RAW_MOUSE_MOTION input mode works
pub fun raw_mouse_motion_supported() bool {
    ret c.glfwRawMouseMotionSupported() != 0;
}

# printable name of a key
# ---
# key:      a key.KEY_* token, or KEY_UNKNOWN to use the scancode
# scancode: platform scancode, ignored unless key is KEY_UNKNOWN
# ret:      GLFW-owned string, nil for non-printable keys
pub fun get_key_name(key: i32, scancode: i32) str {
    ret c.glfwGetKeyName(key, scancode);
}

# platform scancode of a key
# ---
# key: a key.KEY_* token
# ret: scancode, or -1 on error
pub fun get_key_scancode(key: i32) i32 {
    ret c.glfwGetKeyScancode(key);
}

# last reported state of a key
# ---
# window: window to query
# key:    a key.KEY_* token
# ret:    key.PRESS or key.RELEASE
pub fun get_key(window: Window, key: i32) i32 {
    ret c.glfwGetKey(window.handle, key);
}

# last reported state of a mouse button
# ---
# window: window to query
# button: a mouse.MOUSE_BUTTON_* token
# ret:    key.PRESS or key.RELEASE
pub fun get_mouse_button(window: Window, button: i32) i32 {
    ret c.glfwGetMouseButton(window.handle, button);
}

# cursor position relative to the client area
# ---
# window: window to query
# xpos:   receives the x position
# ypos:   receives the y position
pub fun get_cursor_pos(window: Window, xpos: *f64, ypos: *f64) {
    c.glfwGetCursorPos(window.handle, xpos, ypos);
}

# move the cursor within the focused window
# ---
# window: window owning the cursor
# xpos:   new x position
# ypos:   new y position
pub fun set_cursor_pos(window: Window, xpos: f64, ypos: f64) {
    c.glfwSetCursorPos(window.handle, xpos, ypos);
}

# create a custom cursor from an image
# ---
# image: cursor image
# xhot:  hotspot x, in pixels from the left
# yhot:  hotspot y, in pixels from the top
# ret:   the new Cursor; nil handle on failure
pub fun create_cursor(image: *c.Image, xhot: i32, yhot: i32) Cursor {
    ret Cursor{ handle: c.glfwCreateCursor(image, xhot, yhot) };
}

# create a themed standard cursor
# ---
# shape: a mouse.*_CURSOR shape token
# ret:   the new Cursor; nil handle on failure
pub fun create_standard_cursor(shape: i32) Cursor {
    ret Cursor{ handle: c.glfwCreateStandardCursor(shape) };
}

# destroy a cursor created with create_cursor or
# create_standard_cursor
# ---
# cursor: cursor to destroy
pub fun destroy_cursor(cursor: Cursor) {
    c.glfwDestroyCursor(cursor.handle);
}

# set the cursor image shown over the window's client area
# ---
# window: window to change
# cursor: cursor to show, or no_cursor() for the default
pub fun set_cursor(window: Window, cursor: Cursor) {
    c.glfwSetCursor(window.handle, cursor.handle);
}

# install the key callback
# ---
# window:   window to observe
# callback: handler, or nil cast to the callback type (e.g. nil::KeyFun) to clear
pub fun set_key_callback(window: Window, callback: KeyFun) {
    c.glfwSetKeyCallback(window.handle, callback);
}

# install the text input callback
# ---
# window:   window to observe
# callback: handler, or nil cast to the callback type (e.g. nil::KeyFun) to clear
pub fun set_char_callback(window: Window, callback: CharFun) {
    c.glfwSetCharCallback(window.handle, callback);
}

# install the text-with-modifiers callback
# ---
# window:   window to observe
# callback: handler, or nil cast to the callback type (e.g. nil::KeyFun) to clear
pub fun set_char_mods_callback(window: Window, callback: CharModsFun) {
    c.glfwSetCharModsCallback(window.handle, callback);
}

# install the mouse button callback
# ---
# window:   window to observe
# callback: handler, or nil cast to the callback type (e.g. nil::KeyFun) to clear
pub fun set_mouse_button_callback(window: Window, callback: MouseButtonFun) {
    c.glfwSetMouseButtonCallback(window.handle, callback);
}

# install the cursor position callback
# ---
# window:   window to observe
# callback: handler, or nil cast to the callback type (e.g. nil::KeyFun) to clear
pub fun set_cursor_pos_callback(window: Window, callback: CursorPosFun) {
    c.glfwSetCursorPosCallback(window.handle, callback);
}

# install the cursor enter/leave callback
# ---
# window:   window to observe
# callback: handler, or nil cast to the callback type (e.g. nil::KeyFun) to clear
pub fun set_cursor_enter_callback(window: Window, callback: CursorEnterFun) {
    c.glfwSetCursorEnterCallback(window.handle, callback);
}

# install the scroll callback
# ---
# window:   window to observe
# callback: handler, or nil cast to the callback type (e.g. nil::KeyFun) to clear
pub fun set_scroll_callback(window: Window, callback: ScrollFun) {
    c.glfwSetScrollCallback(window.handle, callback);
}

# install the path drop callback
# ---
# window:   window to observe
# callback: handler, or nil cast to the callback type (e.g. nil::KeyFun) to clear
pub fun set_drop_callback(window: Window, callback: DropFun) {
    c.glfwSetDropCallback(window.handle, callback);
}

# set the system clipboard text
# ---
# window: deprecated, any valid window or no_window()
# string: UTF-8 text, copied before return
pub fun set_clipboard_string(window: Window, string: str) {
    c.glfwSetClipboardString(window.handle, string);
}

# read the system clipboard text
# ---
# window: deprecated, any valid window or no_window()
# ret:    GLFW-owned string, nil if unavailable
pub fun get_clipboard_string(window: Window) str {
    ret c.glfwGetClipboardString(window.handle);
}

# whether a joystick is connected
# ---
# jid: a joystick.JOYSTICK_* id
# ret: true if present
pub fun joystick_present(jid: i32) bool {
    ret c.glfwJoystickPresent(jid) != 0;
}

# axis values of a joystick, each -1 to 1
# ---
# jid:   a joystick.JOYSTICK_* id
# count: receives the axis count
# ret:   GLFW-owned array, nil if absent
pub fun get_joystick_axes(jid: i32, count: *i32) *f32 {
    ret c.glfwGetJoystickAxes(jid, count);
}

# button states of a joystick
# ---
# jid:   a joystick.JOYSTICK_* id
# count: receives the button count
# ret:   GLFW-owned array of key.PRESS/key.RELEASE, nil if absent
pub fun get_joystick_buttons(jid: i32, count: *i32) *u8 {
    ret c.glfwGetJoystickButtons(jid, count);
}

# hat states of a joystick
# ---
# jid:   a joystick.JOYSTICK_* id
# count: receives the hat count
# ret:   GLFW-owned array of joystick.HAT_* bitfields, nil if absent
pub fun get_joystick_hats(jid: i32, count: *i32) *u8 {
    ret c.glfwGetJoystickHats(jid, count);
}

# human-readable joystick name
# ---
# jid: a joystick.JOYSTICK_* id
# ret: GLFW-owned string, nil if absent
pub fun get_joystick_name(jid: i32) str {
    ret c.glfwGetJoystickName(jid);
}

# SDL-compatible joystick GUID
# ---
# jid: a joystick.JOYSTICK_* id
# ret: GLFW-owned string, nil if absent
pub fun get_joystick_guid(jid: i32) str {
    ret c.glfwGetJoystickGUID(jid);
}

# attach a user pointer to the joystick slot
# ---
# jid:     a joystick.JOYSTICK_* id
# pointer: arbitrary user data
pub fun set_joystick_user_pointer(jid: i32, pointer: ptr) {
    c.glfwSetJoystickUserPointer(jid, pointer);
}

# read the joystick slot's user pointer
# ---
# jid: a joystick.JOYSTICK_* id
# ret: the user pointer, nil if unset
pub fun get_joystick_user_pointer(jid: i32) ptr {
    ret c.glfwGetJoystickUserPointer(jid);
}

# whether the joystick has a gamepad mapping
# ---
# jid: a joystick.JOYSTICK_* id
# ret: true if a mapping exists
pub fun joystick_is_gamepad(jid: i32) bool {
    ret c.glfwJoystickIsGamepad(jid) != 0;
}

# install the joystick configuration callback
# ---
# callback: handler, or nil cast to the callback type (e.g. nil::KeyFun) to clear
pub fun set_joystick_callback(callback: JoystickFun) {
    c.glfwSetJoystickCallback(callback);
}

# add SDL_GameControllerDB mappings
# ---
# string: mapping lines in SDL format
# ret:    true on success
pub fun update_gamepad_mappings(string: str) bool {
    ret c.glfwUpdateGamepadMappings(string) != 0;
}

# human-readable gamepad name from the mapping
# ---
# jid: a joystick.JOYSTICK_* id
# ret: GLFW-owned string, nil if not a gamepad
pub fun get_gamepad_name(jid: i32) str {
    ret c.glfwGetGamepadName(jid);
}

# read the joystick through its gamepad mapping
# ---
# jid:   a joystick.JOYSTICK_* id
# state: receives the mapped state
# ret:   true if the joystick is a connected gamepad
pub fun get_gamepad_state(jid: i32, state: *c.Gamepadstate) bool {
    ret c.glfwGetGamepadState(jid, state) != 0;
}
