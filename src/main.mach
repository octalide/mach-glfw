# glfw.main: demo executable for the GLFW bindings.
#
# opens a window with an OpenGL context, loads glClearColor/glClear
# through the context's proc loader, and animates the clear color until
# the window is closed or ESC is pressed.

use std.runtime;
use std.types.bool.true;
use print: std.print;
use glfw.glfw;

# GlClearColorFun: glClearColor(red, green, blue, alpha).
def GlClearColorFun: fun(f32, f32, f32, f32);
# GlClearFun: glClear(mask).
def GlClearFun: fun(u32);

val GL_COLOR_BUFFER_BIT: u32 = 0x00004000;

fun on_error(code: i32, desc: *u8) {
    print.eprintf("glfw error 0x%x: %s\n", code::u64, desc);
}

fun on_key(handle: ptr, key: i32, scancode: i32, action: i32, mods: i32) {
    if (action == glfw.PRESS && key == glfw.KEY_ESCAPE) {
        val w: glfw.Window = glfw.window_from_handle(handle);
        glfw.set_window_should_close(w, true);
    }
}

$main.symbol = "main";
fun main(argc: i64, argv: **u8) i64 {
    glfw.set_error_callback(on_error);

    if (!glfw.init()) {
        print.eprintln("failed to initialize GLFW");
        ret 1;
    }

    var major: i32 = 0;
    var minor: i32 = 0;
    var rev: i32 = 0;
    glfw.get_version(?major, ?minor, ?rev);
    print.printf("GLFW %d.%d.%d\n", major::i64, minor::i64, rev::i64);

    val w: glfw.Window = glfw.open_window(800, 600, "mach-glfw");
    if (!glfw.window_is_valid(w)) {
        print.eprintln("failed to create window");
        glfw.terminate();
        ret 1;
    }

    glfw.make_context_current(w);
    glfw.swap_interval(1);
    glfw.set_key_callback(w, on_key);

    val clear_color: GlClearColorFun = glfw.get_proc_address("glClearColor"):~GlClearColorFun;
    val clear: GlClearFun = glfw.get_proc_address("glClear"):~GlClearFun;
    if (clear_color == nil || clear == nil) {
        print.eprintln("failed to load GL functions");
        glfw.terminate();
        ret 1;
    }

    for (!glfw.window_should_close(w)) {
        val t: f64 = glfw.get_time();
        val phase: f64 = (t * 0.25) % 1.0;
        clear_color(phase::f32, 0.3, 1.0 - phase::f32, 1.0);
        clear(GL_COLOR_BUFFER_BIT);
        glfw.swap_buffers(w);
        glfw.poll_events();
    }

    glfw.destroy_window(w);
    glfw.terminate();
    print.println("bye");
    ret 0;
}
