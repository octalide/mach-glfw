# error codes

pub val NO_ERROR: i32 = 0;
pub val NOT_INITIALIZED: i32 = 0x00010001;
pub val NO_CURRENT_CONTEXT: i32 = 0x00010002;
pub val INVALID_ENUM: i32 = 0x00010003;
pub val INVALID_VALUE: i32 = 0x00010004;
pub val OUT_OF_MEMORY: i32 = 0x00010005;
pub val API_UNAVAILABLE: i32 = 0x00010006;
pub val VERSION_UNAVAILABLE: i32 = 0x00010007;
pub val PLATFORM_ERROR: i32 = 0x00010008;
pub val FORMAT_UNAVAILABLE: i32 = 0x00010009;
pub val NO_WINDOW_CONTEXT: i32 = 0x0001000A;
pub val CURSOR_UNAVAILABLE: i32 = 0x0001000B;
pub val FEATURE_UNAVAILABLE: i32 = 0x0001000C;
pub val FEATURE_UNIMPLEMENTED: i32 = 0x0001000D;
pub val PLATFORM_UNAVAILABLE: i32 = 0x0001000E;
