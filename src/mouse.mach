# mouse buttons and standard cursor shapes

# mouse buttons
pub val MOUSE_BUTTON_1: i32 = 0;
pub val MOUSE_BUTTON_2: i32 = 1;
pub val MOUSE_BUTTON_3: i32 = 2;
pub val MOUSE_BUTTON_4: i32 = 3;
pub val MOUSE_BUTTON_5: i32 = 4;
pub val MOUSE_BUTTON_6: i32 = 5;
pub val MOUSE_BUTTON_7: i32 = 6;
pub val MOUSE_BUTTON_8: i32 = 7;
pub val MOUSE_BUTTON_LAST: i32 = MOUSE_BUTTON_8;
pub val MOUSE_BUTTON_LEFT: i32 = MOUSE_BUTTON_1;
pub val MOUSE_BUTTON_RIGHT: i32 = MOUSE_BUTTON_2;
pub val MOUSE_BUTTON_MIDDLE: i32 = MOUSE_BUTTON_3;

# standard cursor shapes
pub val ARROW_CURSOR: i32 = 0x00036001;
pub val IBEAM_CURSOR: i32 = 0x00036002;
pub val CROSSHAIR_CURSOR: i32 = 0x00036003;
pub val POINTING_HAND_CURSOR: i32 = 0x00036004;
pub val RESIZE_EW_CURSOR: i32 = 0x00036005;
pub val RESIZE_NS_CURSOR: i32 = 0x00036006;
pub val RESIZE_NWSE_CURSOR: i32 = 0x00036007;
pub val RESIZE_NESW_CURSOR: i32 = 0x00036008;
pub val RESIZE_ALL_CURSOR: i32 = 0x00036009;
pub val NOT_ALLOWED_CURSOR: i32 = 0x0003600A;

# legacy cursor shape aliases
pub val HRESIZE_CURSOR: i32 = RESIZE_EW_CURSOR;
pub val VRESIZE_CURSOR: i32 = RESIZE_NS_CURSOR;
pub val HAND_CURSOR: i32 = POINTING_HAND_CURSOR;
